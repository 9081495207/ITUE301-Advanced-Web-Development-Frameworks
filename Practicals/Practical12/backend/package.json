{
  "name": "practical12-cicd-pipeline-backend",
  "version": "1.0.0",
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions — Jest + Supertest automated tests for the Task Management API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.2.0",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@9.5.0": true,
    "unrs-resolver@1.12.2": true
  }
}
